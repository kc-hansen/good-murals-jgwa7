# Good Murals — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# Set these in AWS Amplify console → App settings → Environment variables.

# ─── Sanity CMS ───
NEXT_PUBLIC_SANITY_PROJECT_ID=          # e.g. "8t2dx4n0" — public
NEXT_PUBLIC_SANITY_DATASET=production   # "production"
SANITY_API_READ_TOKEN=                  # private; for draft preview only

# ─── Stripe ───
STRIPE_SECRET_KEY=                      # sk_live_... (server-only, never public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # pk_live_...
STRIPE_CONNECTED_ACCOUNT_ID=            # acct_... (artist's Connect account)
STRIPE_WEBHOOK_SECRET=                  # whsec_... (from Stripe webhook dashboard)
DEPOSIT_AMOUNT_CENTS=25000              # $250 = 25000; change without code deploy
TECH_FEE_PERCENT=0.05                   # 5%

# ─── Resend ───
RESEND_API_KEY=                         # private; server-only
RESEND_TO_ARTIST=                       # artist's notification email
RESEND_FROM_ADDRESS=                    # e.g. "Good Murals <hello@goodmurals.com>"

# ─── Plausible Analytics ───
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=           # e.g. "goodmurals.com" or preview domain

# ─── Site Config ───
NEXT_PUBLIC_SITE_URL=https://good-murals-jgwa7.yourproject.ai   # update for production
NODE_ENV=development                    # Amplify sets this to "production"
